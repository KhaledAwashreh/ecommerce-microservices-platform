# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# Never commit `.env` — see CLAUDE.md and issues #15/#16.

# Common
ZIPKIN_BASE_URL=http://zipkin:9411
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka

# Database
# A weak shared password is defensible for local dev — just don't commit it.
# Pick anything; it only has to match across the containers on your machine.
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=changeme

# User Service Database
USER_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/userdb

# Product Service Database
PRODUCT_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/productdb

# Order Service Database
ORDER_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/orderdb

# Payment Service Database
PAYMENT_SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/paymentdb

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT
# HS256 signing secret shared by api-gateway and user-service — required, no
# default is committed anywhere, so both services refuse to start without it.
# Generate your own: openssl rand -base64 48
JWT_SECRET=changeme-generate-your-own-secret-openssl-rand-base64-48
